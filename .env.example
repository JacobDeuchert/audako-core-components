# Copy to .env.local (gitignored) to preselect the audako system the Storybook
# stories talk to. Without it, pick one with the audako system tool in the
# Storybook toolbar or open Storybook with ?system=<url>.
#
# Storybook loads the system's own application.config and logs in through its
# Keycloak (see .storybook/auth.ts). The system's Keycloak client must list the
# Storybook origin (e.g. https://devvm:6006) as a web origin and <origin>/* as
# a redirect URI.
VITE_AUDAKO_SYSTEM=

# Serve Storybook over https (.storybook/dev.mjs). Required once the system's
# certificate is trusted: Keycloak's HSTS header then covers every port of the
# host. SB_HTTPS_KEY may be left out when the key is in the same PEM file.
SB_HTTPS_CERT=
SB_HTTPS_KEY=
