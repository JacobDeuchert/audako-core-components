{
  "name": "@audako/core-components",
  "version": "2.2.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --project tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "update-core": "npm i @audako/core@^2",
    "storybook": "node .storybook/dev.mjs",
    "build-storybook": "storybook build",
    "prettier": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/svelte": "10.5.10",
    "@storybook/svelte-vite": "10.5.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "10.5.10",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@audako/core": "^2.1.0",
    "@ngneat/elf": "^2.1.0",
    "@ngneat/elf-persist-state": "^1.1.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.6",
    "tsyringe": "^4.7.0",
    "uuid": "^8.3.2"
  },
  "overrides": {
    "@storybook/addon-svelte-csf": {
      "storybook": "$storybook",
      "@storybook/svelte": "$@storybook/svelte"
    }
  },
  "author": "Jacob Deuchert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobDeuchert/audako-core-components.git"
  },
  "publishConfig": {
    "registry": "https://git.dev.audako.net/api/packages/audako/npm/"
  }
}
